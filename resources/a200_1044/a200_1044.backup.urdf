  <!-- gazebo_plugin -->
  <!-- Load this only once in the main platform -->
  <!--
    <xacro:property name="namespace" value="$(arg namespace)"/>
    <xacro:if value="${load_gazebo_plugin}">
      <xacro:property name="ros2_control_params" value="$(find hsky_gazebo)/config/control/control.yaml"/>
      <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>${ros2_control_params}</parameters>
        <ros>
          <namespace>a200_1044</namespace>
          <remapping>/tf:=/a200_1044/tf</remapping>
          <remapping>/tf_static:=/a200_1044/tf_static</remapping>
          <remapping>/diagnostics:=/a200_1044/diagnostics</remapping>
          <remapping>/dynamic_joint_states:=/a200_1044/platform/dynamic_joint_states</remapping>
          <remapping>joint_states:=/a200_1044/platform/joint_states</remapping>
        </ros>
      </plugin>
    </gazebo>    
    </xacro:if>
    -->
  <!-- Insert at the end of xarm_device_macro.xacro -->
  <ros2_control name="RobotiqGripperHardwareInterface" type="system">
    <!-- Plugins -->
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <!-- Joint interfaces -->
    <!-- With Ignition or Hardware, they handle mimic joints, so we only need this command interface activated -->
    <joint name="finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.695</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_inner_knuckle_joint">
      <param name="mimic">finger_joint</param>
      <param name="multiplier">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_inner_finger_joint">
      <param name="mimic">finger_joint</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_outer_knuckle_joint">
      <param name="mimic">finger_joint</param>
      <param name="multiplier">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_inner_knuckle_joint">
      <param name="mimic">finger_joint</param>
      <param name="multiplier">-1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_inner_finger_joint">
      <param name="mimic">finger_joint</param>
      <param name="multiplier">1</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <!-- We set false, we add gazebo control to the main platform -->
  <!--
    <xacro:if value="${sim_ignition}">
    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin"> 
        <parameters>$(arg gazebo_controllers)</parameters>
        <ros>
          <namespace>$(arg namespace)</namespace>
          <remapping>/tf:=/${namespace}/tf</remapping>
          <remapping>/tf_static:=/${namespace}/tf_static</remapping>
          <remapping>/diagnostics:=/${namespace}/diagnostics</remapping>
          <remapping>/dynamic_joint_states:=/${namespace}/platform/dynamic_joint_states</remapping>
          <remapping>joint_states:=/${namespace}/platform/joint_states</remapping>
        </ros>
      </plugin>
    </gazebo>
     </xacro:if>
     -->
